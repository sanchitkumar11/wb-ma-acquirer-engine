# Copy to .env and fill in only what you need. .env is git-ignored; never commit keys.
# Nothing here is needed to replay the committed report: `python -m acquirer_engine run` works with no .env.

# --- LLM (only for regenerating with --allow-paid; install requirements-llm.txt first) ---
# databricks | anthropic | replay (replay = cached outputs only, no key, no cost)
LLM_PROVIDER=replay
# Databricks Model Serving: a CLI profile name, or host + token
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Anthropic API (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional endpoint overrides per role; defaults are in configs/llm_prices.yaml
LLM_WRITER_ENDPOINT=
LLM_WRITER_DEV_ENDPOINT=
LLM_JUDGE_ENDPOINT=
LLM_OPEN_WEIGHT_ENDPOINT=
# Hard spend cap across all runs, in USD (checked against ledger/cost_ledger.jsonl before every call)
LLM_BUDGET_USD=50
# Optional: write outputs to another cache folder (e.g. to time a cold run without touching cache/llm)
LLM_CACHE_DIR=
# Optional: replay outputs written by a non-default provider (e.g. anthropic); live Anthropic runs tag keys themselves
LLM_CACHE_TAG=
# Optional: LangSmith tracing (read by LangChain itself)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ma-acquirer-engine

# --- Paths ---
# Optional: the repository root, if the package is installed somewhere other than this checkout
ACQUIRER_ENGINE_ROOT=

# --- Charts in the Markdown report ---
# A Chromium browser for exporting chart images (Chrome or Edge); without one the report renders without images
BROWSER_PATH=

# --- SEC EDGAR (only to refresh buyer-profile facts) ---
# A descriptive name plus your contact email, as SEC fair access requires
SEC_USER_AGENT=
EDGAR_CACHE_DIR=
# 1 = read only from the EDGAR cache, never the network
EDGAR_OFFLINE=
# Optional: CA bundle if your network intercepts TLS
EDGAR_CA_BUNDLE=
